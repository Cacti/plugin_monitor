msgstr "На всеки %d минути"

#: setup.php
msgid "Every Hour"
msgstr "Всеки час"

#: setup.php
#, php-format
msgid "Every %d Hours"
msgstr "На всеки %d часа"

#: setup.php
msgid "Reboot Notifications"
msgstr "Известия за рестартиране"

#: setup.php
msgid "Send Reboot Notifications"
msgstr "Изпращане на известия за рестартиране"

#: setup.php
msgid "Should Device Reboot Notifications be sent to users?"
msgstr "Да се изпращат ли известия за рестартиране на устройства до потребителите?"

#: setup.php
msgid "Send one Email to all addresses"
msgstr "Изпращане на един имейл до всички адреси"

#: setup.php
msgid "If checked, the system will send one Email only to all addresses."
msgstr "Ако е отметнато, системата ще изпраща само един имейл до всички адреси."

#: setup.php
msgid "Include Threshold Alert Lists"
msgstr "Включване на списъци с предупреждения за прагове"

#: setup.php
msgid "Should Threshold Alert Lists also receive Notification"
msgstr "Дали списъците с прагови предупреждения също да получават известия"

#: setup.php
msgid "Subject"
msgstr "Тема"

#: setup.php
msgid "Enter a Reboot message subject for the Reboot Notification."
msgstr "Въведете тема на съобщението за рестартиране за известието при рестартиране."

#: setup.php
msgid "Cacti Device Reboot Notification"
msgstr "Известие за рестартиране на устройство в Cacti"

#: setup.php
msgid "Email Body"
msgstr "Текст на имейла"

#: setup.php
msgid "Enter an Email body to include in the Reboot Notification message.  Currently, the only supported replacement tag accepted is &#060;DETAILS&#062;"
msgstr "Въведете текст на имейла, който да бъде включен в съобщението за известие при рестартиране. Понастоящем единственият поддържан маркер за заместване е &#060;DETAILS&#062;"

#: setup.php
msgid "<h1>Monitor Reboot Notification</h1><p>The following Device's were Rebooted.  See details below for additional information.</p><br><DETAILS>"
msgstr "<h1>Известие на Monitor за рестартиране</h1><p>Следните устройства бяха рестартирани. Вижте подробностите по-долу за допълнителна информация.</p><br><DETAILS>"

