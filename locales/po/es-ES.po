msgid "Reboot Notifications"
msgstr "Notificaciones de reinicio"

#: setup.php
msgid "Send Reboot Notifications"
msgstr "Enviar notificaciones de reinicio"

#: setup.php
msgid "Should Device Reboot Notifications be sent to users?"
msgstr "¿Deben enviarse las notificaciones de reinicio de dispositivo a los usuarios?"

#: setup.php
msgid "Send one Email to all addresses"
msgstr "Enviar un correo electrónico a todas las direcciones"

#: setup.php
msgid "If checked, the system will send one Email only to all addresses."
msgstr "Si se marca, el sistema enviará un único correo electrónico a todas las direcciones."

#: setup.php
msgid "Include Threshold Alert Lists"
msgstr "Incluir listas de alertas de umbral"

#: setup.php
msgid "Should Threshold Alert Lists also receive Notification"
msgstr "Enviar notificación también a las listas de alertas de umbral"

#: setup.php
msgid "Subject"
msgstr "Asunto"

#: setup.php
msgid "Enter a Reboot message subject for the Reboot Notification."
msgstr "Introduzca un asunto del mensaje de reinicio para la notificación de reinicio."

#: setup.php
msgid "Cacti Device Reboot Notification"
msgstr "Notificación de reinicio de dispositivo de Cacti"

#: setup.php
msgid "Email Body"
msgstr "Contenido del correo"

#: setup.php
msgid "Enter an Email body to include in the Reboot Notification message.  Currently, the only supported replacement tag accepted is &#060;DETAILS&#062;"
msgstr "Introduzca un cuerpo de correo electrónico para incluirlo en el mensaje de notificación de reinicio. Actualmente, la única etiqueta de reemplazo admitida es &#060;DETAILS&#062;"

#: setup.php
msgid "<h1>Monitor Reboot Notification</h1><p>The following Device's were Rebooted.  See details below for additional information.</p><br><DETAILS>"
msgstr "<h1>Notificación de reinicio de Monitor</h1><p>Los siguientes dispositivos se han reiniciado. Consulte los detalles a continuación para obtener más información.</p><br><DETAILS>"

