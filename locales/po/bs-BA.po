#: setup.php
msgid "Email Body"
msgstr "Sadržaj e-maila"

#: setup.php
msgid "Enter an Email body to include in the Reboot Notification message.  Currently, the only supported replacement tag accepted is &#060;DETAILS&#062;"
msgstr "Unesite sadržaj e-maila koji će biti uključen u poruku obavještenja o ponovnom pokretanju.  Trenutno je jedina podržana zamjenska oznaka &#060;DETAILS&#062;"

#: setup.php
msgid "<h1>Monitor Reboot Notification</h1><p>The following Device's were Rebooted.  See details below for additional information.</p><br><DETAILS>"
msgstr "<h1>Obavještenje nadzora o ponovnom pokretanju</h1><p>Sljedeći uređaji su ponovo pokrenuti.  Pogledajte detalje ispod za dodatne informacije.</p><br><DETAILS>"

