msgstr "Toutes les %d heures"

#: setup.php
msgid "Reboot Notifications"
msgstr "Notifications de redémarrage"

#: setup.php
msgid "Send Reboot Notifications"
msgstr "Envoyer les notifications de redémarrage"

#: setup.php
msgid "Should Device Reboot Notifications be sent to users?"
msgstr "Les notifications de redémarrage d'équipement doivent-elles être envoyées aux utilisateurs ?"

#: setup.php
msgid "Send one Email to all addresses"
msgstr "Envoyer un seul e-mail à toutes les adresses"

#: setup.php
msgid "If checked, the system will send one Email only to all addresses."
msgstr "Si cette case est cochée, le système n'enverra qu'un seul e-mail à toutes les adresses."

#: setup.php
msgid "Include Threshold Alert Lists"
msgstr "Inclure les listes d'alertes de seuil"

#: setup.php
msgid "Should Threshold Alert Lists also receive Notification"
msgstr "Envoyer également la notification aux listes d'alertes de seuil"

#: setup.php
msgid "Subject"
msgstr "Sujet"

#: setup.php
msgid "Enter a Reboot message subject for the Reboot Notification."
msgstr "Saisissez un objet de message pour la notification de redémarrage."

#: setup.php
msgid "Cacti Device Reboot Notification"
msgstr "Notification de redémarrage d'équipement Cacti"

#: setup.php
msgid "Email Body"
msgstr "Corps de l’email"

#: setup.php
msgid "Enter an Email body to include in the Reboot Notification message.  Currently, the only supported replacement tag accepted is &#060;DETAILS&#062;"
msgstr "Saisissez le corps de l'e-mail à inclure dans le message de notification de redémarrage. Actuellement, la seule balise de remplacement prise en charge est &#060;DETAILS&#062;"

#: setup.php
msgid "<h1>Monitor Reboot Notification</h1><p>The following Device's were Rebooted.  See details below for additional information.</p><br><DETAILS>"
msgstr "<h1>Notification de redémarrage Monitor</h1><p>Les équipements suivants ont été redémarrés. Voir les détails ci-dessous pour plus d'informations.</p><br><DETAILS>"

